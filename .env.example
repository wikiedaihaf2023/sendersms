# ======================
# اعدادات مزود الرسائل
# ======================
# اختر أحد المزودين: twilio أو yemen_mobile أو sapa_phone أو you أو phone_gateway
SMS_PROVIDER=yemen_mobile
SMS_TIMEOUT_SECONDS=30

# ===== Twilio =====
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ===== Yemen Mobile / API URL =====
YEMEN_MOBILE_URL=https://your-yemen-mobile-gateway.example.com/api/send
YEMEN_MOBILE_USERNAME=your_username
YEMEN_MOBILE_PASSWORD=your_password
YEMEN_MOBILE_SENDER=MessageFlow
YEMEN_MOBILE_API_KEY=your_api_key_optional

# ===== Sapa Phone / API URL =====
SAPA_PHONE_URL=https://your-sapa-gateway.example.com/api/send
SAPA_PHONE_USERNAME=your_username
SAPA_PHONE_PASSWORD=your_password
SAPA_PHONE_SENDER=MessageFlow
SAPA_PHONE_API_KEY=your_api_key_optional

# ===== YOU / API URL =====
YOU_URL=https://your-you-gateway.example.com/api/send
YOU_USERNAME=your_username
YOU_PASSWORD=your_password
YOU_SENDER=MessageFlow
YOU_API_KEY=your_api_key_optional

# ===== بوابة الهاتف / Sapa GSM / Local HTTP Gateway (اختياري - للإرسال من شريحة الهاتف مباشرة) =====
PHONE_GATEWAY_URL=http://192.168.1.15:8080/send_sms
PHONE_GATEWAY_USERNAME=
PHONE_GATEWAY_PASSWORD=
PHONE_GATEWAY_SENDER=
PHONE_GATEWAY_API_KEY=
PHONE_GATEWAY_METHOD=get

# ======================
# إعدادات Meta Business API (اختياري - بديل لواتس آب)
# ======================
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_API_VERSION=v19.0

# ======================
# إعدادات عامة
# ======================
APP_NAME=MessageFlow Pro
APP_VERSION=1.0.0
DEFAULT_COUNTRY_CODE=SA
LOG_LEVEL=INFO
DEBUG=False
TEST_MODE=False

# مفتاح سري لتطبيق الويب
SECRET_KEY=change_this_to_random_secret

# ======================
# إعدادات متقدمة (اختياري)
# ======================
# معدل الإرسال (رسائل في الثانية)
# SMS_PER_SECOND=1
# WHATSAPP_PER_SECOND=1
# تأخير بين الأرقام (بالثواني)
# DELAY_BETWEEN_MESSAGES=1
# عدد محاولات الإعادة والتأخير بينها
# MAX_RETRIES=3
# RETRY_DELAY=2
# تخصيص الرسائل
# ENABLE_PERSONALIZATION=True
# DEFAULT_MESSAGE=عزيزي العميل، تم تجهيز جواز سفرك وهو جاهز للاستلام.
# PERSONALIZED_TEMPLATE=عزيزي {name}، تم تجهيز جواز سفرك رقم {passport} وهو جاهز للاستلام.
# مسار قاعدة البيانات (اختياري)
# DB_PATH=data/messageflow.db
